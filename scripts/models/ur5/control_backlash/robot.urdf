<robot name="ur5_position_probe">
  <link name="world" />
  <link name="base_link" />
  <joint name="world__base_link" type="fixed">
    <parent link="world" />
    <child link="base_link" />
    <origin xyz="0.0 0.0 0.5" rpy="0.0 0.0 0.0" />
  </joint>
  <link name="base_link_inertia" />
  <joint name="base_link__base_link_inertia" type="fixed">
    <parent link="base_link" />
    <child link="base_link_inertia" />
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 3.141592653589793" />
  </joint>
  <link name="shoulder_link" />
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link_inertia" />
    <child link="shoulder_pan_drive_frame" />
    <origin xyz="0.0 0.0 0.089159" rpy="0.0 0.0 0.0" />
    <axis xyz="0 0 1" />
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="150.0" velocity="3.14" />
  </joint>
  <link name="upper_arm_link" />
  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link" />
    <child link="shoulder_lift_drive_frame" />
    <origin xyz="0.0 0.0 0.0" rpy="1.570796327 0.0 0.0" />
    <axis xyz="0 0 1" />
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="150.0" velocity="3.14" />
  </joint>
  <link name="forearm_link" />
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link" />
    <child link="elbow_drive_frame" />
    <origin xyz="-0.425 0.0 0.0" rpy="0.0 0.0 0.0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="150.0" velocity="3.14" />
  </joint>
  <link name="wrist_1_link" />
  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link" />
    <child link="wrist_1_drive_frame" />
    <origin xyz="-0.39225 0.0 0.10915" rpy="0.0 0.0 0.0" />
    <axis xyz="0 0 1" />
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="28.0" velocity="3.14" />
  </joint>
  <link name="wrist_2_link" />
  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link" />
    <child link="wrist_2_drive_frame" />
    <origin xyz="0.0 -0.09465 -1.941303950897609e-11" rpy="1.570796327 0.0 0.0" />
    <axis xyz="0 0 1" />
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="28.0" velocity="3.14" />
  </joint>
  <link name="wrist_3_link" />
  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link" />
    <child link="wrist_3_drive_frame" />
    <origin xyz="0.0 0.0823 -1.688001216681175e-11" rpy="-1.570796327 2.220446049250313e-16 -1.1102230246251565e-16" />
    <axis xyz="0 0 1" />
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="28.0" velocity="3.14" />
  </joint>
  <link name="tool0" />
  <joint name="wrist3_to_tool0" type="fixed">
    <parent link="wrist_3_link" />
    <child link="tool0" />
    <origin xyz="0.0 0.0 0.0" rpy="-2.465190328815662e-32 0.0 2.220446049250313e-16" />
  </joint>
  <ros2_control name="MujocoSystem" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
      <param name="mujoco_model">../scene_backlash.xml</param>
      <param name="pids_config_file">pids.yaml</param>
      <param name="headless">true</param>
      <param name="sim_speed_factor">1.0</param>
      <param name="initial_keyframe">hold</param>
      <param name="auto_register_cameras">false</param>
    </hardware>
    <joint name="shoulder_pan_joint">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="shoulder_lift_joint">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">-1.185</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="elbow_joint">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">1.5850000000000002</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="wrist_1_joint">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">-1.792</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="wrist_2_joint">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">-1.108</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="wrist_3_joint">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="shoulder_pan_gap">
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="shoulder_lift_gap">
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="elbow_gap">
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="wrist_1_gap">
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="wrist_2_gap">
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="wrist_3_gap">
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
  </ros2_control>
  <link name="shoulder_pan_drive_frame" />
  <joint name="shoulder_pan_gap" type="revolute">
    <parent link="shoulder_pan_drive_frame" />
    <child link="shoulder_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-0.00014544410433286079" upper="0.00014544410433286079" effort="150.0" velocity="3.14" />
  </joint>
  <link name="shoulder_lift_drive_frame" />
  <joint name="shoulder_lift_gap" type="revolute">
    <parent link="shoulder_lift_drive_frame" />
    <child link="upper_arm_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-0.00014544410433286079" upper="0.00014544410433286079" effort="150.0" velocity="3.14" />
  </joint>
  <link name="elbow_drive_frame" />
  <joint name="elbow_gap" type="revolute">
    <parent link="elbow_drive_frame" />
    <child link="forearm_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-0.00014544410433286079" upper="0.00014544410433286079" effort="150.0" velocity="3.14" />
  </joint>
  <link name="wrist_1_drive_frame" />
  <joint name="wrist_1_gap" type="revolute">
    <parent link="wrist_1_drive_frame" />
    <child link="wrist_1_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-0.00014544410433286079" upper="0.00014544410433286079" effort="28.0" velocity="3.14" />
  </joint>
  <link name="wrist_2_drive_frame" />
  <joint name="wrist_2_gap" type="revolute">
    <parent link="wrist_2_drive_frame" />
    <child link="wrist_2_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-0.00014544410433286079" upper="0.00014544410433286079" effort="28.0" velocity="3.14" />
  </joint>
  <link name="wrist_3_drive_frame" />
  <joint name="wrist_3_gap" type="revolute">
    <parent link="wrist_3_drive_frame" />
    <child link="wrist_3_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-0.00014544410433286079" upper="0.00014544410433286079" effort="28.0" velocity="3.14" />
